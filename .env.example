# GEMINI_API_KEY: Unused (Skillect uses Supabase + Firebase Messaging/Analytics).
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Your existing Skillect Supabase Project URL (e.g., https://xyzcompany.supabase.co)
# Configure this in the AI Studio Secrets panel. Never commit real credentials.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SUPABASE_ANON_KEY: Your Supabase publishable anon key (safe for client with RLS enabled).
# NEVER put the Supabase service_role key in client config.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
